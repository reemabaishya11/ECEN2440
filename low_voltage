from machine import ADC, Pin
import time

adc = ADC(Pin(27))
led = Pin(14, Pin.OUT)

# Resistor Values
R1 = 75000
R2 = 47000
ratio = (R1 + R2) / R2

while True:
    sum_val = 0

    # Average values
    for i in range(30):
        reading = adc.read_u16()
        sum_val += reading
        time.sleep(.01)   # small delay

    average = sum_val / 30
    voltage = average * (3.3 / 65535)

    # Voltage is printed to REPL
    print("Raw:", average, ", Voltage:", voltage)

    # If voltage is below a certain value, turn LED on to indicate low voltage
    if voltage < 3:
        led.on()
    else:
        led.off()
    
    time.sleep(.1)

